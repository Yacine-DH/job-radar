# Copy to .env (chmod 600) and fill in. Never commit .env.
# Gmail SMTP (smtp.gmail.com:587, STARTTLS). Use an App Password, not your account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_TO=
# Optional: link shown in the email footer
DASHBOARD_URL=
# Optional, off by default: a contact (email or URL) appended to the User-Agent sent to job sites.
# Leave empty to stay anonymous; set it yourself only if you want sites to be able to reach you.
JOB_RADAR_CONTACT=
