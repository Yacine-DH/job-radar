[Unit]
Description=Job radar dashboard (Tailscale only, port 8090)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/job-radar
# DASHBOARD_HOST (your Tailscale IP) and DASHBOARD_ALLOWED_HOSTS are read from .env
Environment=DASHBOARD_PORT=8090
ExecStart=%h/job-radar/.venv/bin/python -I %h/job-radar/dashboard.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h/job-radar

[Install]
WantedBy=default.target
