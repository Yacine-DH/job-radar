[Unit]
Description=Job radar dashboard (Tailscale only, port 8090)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/user/job-radar
Environment=DASHBOARD_HOST=100.64.0.1
Environment=DASHBOARD_PORT=8090
Environment=DASHBOARD_ALLOWED_HOSTS=my-server.example.ts.net,100.64.0.1
ExecStart=/home/user/job-radar/.venv/bin/python -I /home/user/job-radar/dashboard.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/home/user/job-radar

[Install]
WantedBy=default.target
